<%# Dark tooltip bubble used by the feedback widget (prompt + success states). %>
<div class="flex items-center drop-shadow-md">
  <div class="relative flex w-[259px] items-start justify-between gap-2.5 rounded-[8px] bg-gray-2 p-2.5 text-white">
    <div class="flex flex-1 flex-col gap-1">
      <p class="text-lg font-semibold leading-tight"><%= title %></p>
      <p class="text-base leading-tight"><%= body %></p>
    </div>
    <button type="button" aria-label="Dismiss" data-action="<%= dismiss_action %>" class="rounded-[4px] p-1 hover:bg-white/10">
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <%# Arrow pointing to the button %>
  <div class="h-0 w-0 border-y-[6px] border-l-[8px] border-y-transparent border-l-gray-2"></div>
</div>
