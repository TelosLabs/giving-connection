<%#
  Floating feedback widget.
  Closed state: a bubble button + "Have any feedback?" tooltip.
  Open state: the feedback form panel (rating faces + category + comment).
  Backend is a UI-only stub for now (FeedbacksController#create).

  Locals (all optional):
    context     - identifies the entry point (e.g. "search", "organization", "discover")
    question    - the rating question shown above the emoji faces
    exit_intent - when true, the form opens automatically when the user is about
                  to leave the page (unless they already sent feedback)
%>
<% context     = local_assigns.fetch(:context, "search") %>
<% question    = local_assigns.fetch(:question, "How was your experience searching for a nonprofit?") %>
<% exit_intent = local_assigns.fetch(:exit_intent, false) %>
<%
  category_options = [
    ["Search results",          "search_results",       "feedback_cat_search.svg"],
    ["Accuracy of matches",     "accuracy_of_matches",  "feedback_cat_accuracy.svg"],
    ["Ease of use",             "ease_of_use",          "feedback_cat_ease.svg"],
    ["Speed / performance",     "speed_performance",    "feedback_cat_speed.svg"],
    ["Filters & sorting",       "filters_sorting",      "feedback_cat_filters.svg"],
    ["Location or map results", "location_map_results", "feedback_cat_location.svg"],
    ["Something didn't work",   "something_didnt_work", "feedback_cat_issue.svg"],
    ["Other",                   "other",                nil]
  ]
%>
<div data-controller="feedback" data-action="click@window->feedback#closeDropdownOutside"
     data-feedback-exit-intent-value="<%= exit_intent %>"
     class="fixed bottom-6 right-6 z-50 flex flex-col items-end">

  <%# Dark overlay, shown only when the form opens as a centered modal (exit case) %>
  <div data-feedback-target="backdrop" data-action="click->feedback#close"
       class="fixed inset-0 z-40 hidden bg-black/50"></div>

  <%# ---------- Closed: trigger (tooltip + button) ---------- %>
  <div data-feedback-target="trigger" class="flex items-center gap-2">
    <%# "Have any feedback?" prompt tooltip %>
    <div data-feedback-target="tooltip">
      <%= render "shared/feedback_tooltip",
            title: "Have any feedback?",
            body: "Tell us how this is going!",
            dismiss_action: "click->feedback#dismissTooltip" %>
    </div>

    <%# Bubble button %>
    <button type="button" aria-label="Give feedback" data-action="click->feedback#open"
            class="flex h-11 w-11 items-center justify-center rounded-[8px] bg-blue-dark drop-shadow-md">
      <%= inline_svg_tag "feedback_bubble.svg", class: "h-[30px] w-[30px]" %>
    </button>
  </div>

  <%# ---------- Open: form panel ---------- %>
  <div data-feedback-target="panel"
       class="hidden w-[calc(100vw_-_2rem)] max-w-[390px] rounded-2xl border border-blue-medium bg-white px-4 py-6 drop-shadow-[0px_4px_7.5px_rgba(0,0,0,0.15)]">
    <%= form_with url: feedbacks_path, method: :post,
          data: { action: "turbo:submit-end->feedback#afterSubmit" }, class: "flex flex-col gap-2" do |f| %>
      <%= hidden_field_tag "feedback[rating]", "", data: { feedback_target: "ratingInput" } %>
      <%= hidden_field_tag "feedback[context]", context %>
      <%= hidden_field_tag "feedback[page_url]", request.original_url %>

      <h2 class="text-2xl font-bold text-blue-dark">Please tell us about your experience</h2>

      <%# Rating faces %>
      <div class="flex flex-col gap-1 border-b border-gray-7 pb-4">
        <p class="text-base font-medium leading-8 text-gray-2"><%= question %></p>
        <%# Each face gets an equal share of the row (flex-1) so they always
            span the full width; the emoji scales down to fit on mobile. %>
        <div class="flex items-center">
          <% [
               [1, "feedback_face_1_mad.svg",   "Mad"],
               [2, "feedback_face_2_sad.svg",   "Sad"],
               [3, "feedback_face_3_meh.svg",   "Meh"],
               [4, "feedback_face_4_happy.svg", "Happy"],
               [5, "feedback_face_5_love.svg",  "Love it"]
             ].each do |rating, icon, label| %>
            <button type="button" data-feedback-target="face" data-rating="<%= rating %>"
                    data-action="click->feedback#selectRating"
                    aria-pressed="false" aria-label="<%= label %>" title="<%= label %>"
                    class="flex flex-1 items-center justify-center rounded-[8px] p-1 transition-colors hover:bg-gray-8 xs:p-2">
              <%= inline_svg_tag icon, class: "aspect-square w-full max-w-[57px]" %>
            </button>
          <% end %>
        </div>
      </div>

      <%# Category (custom dropdown so options can show an icon) %>
      <div class="flex flex-col gap-1 border-b border-gray-7 pb-4">
        <p class="text-base font-medium leading-8 text-gray-2">What would you like to give feedback about?</p>
        <div class="relative" data-feedback-target="dropdown">
          <%= hidden_field_tag "feedback[category]", "", data: { feedback_target: "categoryInput" } %>
          <button type="button" data-action="click->feedback#toggleDropdown"
                  class="flex w-full items-center justify-between rounded-6px border border-gray-5 px-4 py-3 text-base">
            <span data-feedback-target="dropdownLabel" class="flex items-center gap-2 text-gray-4">Select an option...</span>
            <svg class="h-5 w-5 shrink-0 text-gray-4" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul data-feedback-target="dropdownMenu"
              class="absolute z-10 mt-1 hidden max-h-64 w-full overflow-auto rounded-6px border border-gray-5 bg-white py-1 drop-shadow-md">
            <% category_options.each do |label, value, icon| %>
              <li>
                <button type="button" data-action="click->feedback#selectCategory"
                        data-value="<%= value %>"
                        class="flex w-full items-center gap-2 px-4 py-2 text-left text-base text-gray-2 hover:bg-gray-8">
                  <% if icon %>
                    <%= inline_svg_tag icon, class: "h-5 w-5 shrink-0" %>
                  <% else %>
                    <span class="h-5 w-5 shrink-0"></span>
                  <% end %>
                  <%= label %>
                </button>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# Comment %>
      <div class="flex flex-col gap-1">
        <div class="flex items-center justify-between leading-8">
          <p class="text-base font-medium text-gray-2">Leave a comment</p>
          <p class="text-sm text-gray-4">(Optional)</p>
        </div>
        <%= text_area_tag "feedback[comment]", nil, rows: 4,
              placeholder: "Tell us more about your experience...",
              class: "h-[108px] w-full resize-y rounded-6px border border-gray-5 px-4 py-3 text-base text-gray-2 placeholder:text-gray-4 focus:border-blue-medium focus:ring-blue-medium" %>
      </div>

      <%# Actions %>
      <div class="flex items-center justify-end gap-2">
        <button type="button" data-action="click->feedback#close"
                class="px-1 py-1 text-base font-semibold text-blue-dark">Cancel</button>
        <button type="submit" data-feedback-target="submit" disabled
                class="cursor-not-allowed rounded-6px bg-gray-4 px-4 py-2 text-base font-bold text-white opacity-60 disabled:cursor-not-allowed">
          Submit
        </button>
      </div>
    <% end %>
  </div>
</div>
