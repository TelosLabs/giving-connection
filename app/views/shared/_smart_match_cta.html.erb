<%# Page-bottom Smart Match entry point. Dropped at the end of the nonprofit
    profile and discover pages to route users into the Smart Match quiz. %>
<div class="flex flex-col items-center gap-3 px-6 py-12 text-center">
  <p class="text-base font-semibold text-gray-2">
    <%= t("smart_match.entry_points.cta_prompt") %>
  </p>
  <%= link_to t("smart_match.entry_points.cta_button"), smart_match_root_path,
        class: "inline-block px-8 py-3 text-sm font-bold tracking-wider text-blue-dark uppercase rounded-md bg-seafoam hover:bg-seafoam-light transition-colors" %>
</div>
