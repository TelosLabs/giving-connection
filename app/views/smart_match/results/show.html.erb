<%# Hero section %>
<section class="sm-gradient-hero py-16 px-6 sm:py-12" data-controller="smart-match-leave-guard">
  <div class="max-w-2xl mx-auto text-center">
    <h1 class="text-3xl font-bold text-white md:text-4xl"><%= t("smart_match.results.heading") %></h1>
    <p class="mt-4 text-base text-white opacity-90">
      <%= t("smart_match.results.subheading") %>
    </p>
  </div>
</section>

<%# Results section %>
<section class="py-12 px-6 bg-gray-9">
  <div class="max-w-6xl mx-auto">
    <% if @processing %>
      <%# Matches are computed off the request thread (ProcessSubmissionJob).
          This card polls the status endpoint and reloads into the real results
          the moment the job finishes. %>
      <div class="p-12 text-center bg-white rounded-lg shadow-md"
           data-controller="smart-match-poll"
           data-smart-match-poll-status-url-value="<%= status_smart_match_result_path %>"
           data-smart-match-poll-redirect-url-value="<%= smart_match_result_path %>">
        <div class="flex justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-salmon animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
        </div>
        <h2 class="mb-2 text-xl font-bold text-gray-2"><%= t("smart_match.results.processing.title") %></h2>
        <p class="text-gray-4" role="status" aria-live="polite">
          <%= t("smart_match.results.processing.body") %>
        </p>
      </div>

    <% elsif @embedding_unavailable %>
      <div class="p-12 text-center bg-white rounded-lg shadow-md">
        <div class="flex justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-gray-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <h2 class="mb-2 text-xl font-bold text-gray-2"><%= t("smart_match.results.unavailable.title") %></h2>
        <p class="mb-6 text-gray-4">
          <%= t("smart_match.results.unavailable.body") %>
        </p>
        <%# turbo: false so a retry re-enters results as a real navigation,
            keeping the back-button guard working -- see smart-match-leave-guard. %>
        <%= link_to t("smart_match.results.try_again"),
              smart_match_result_path,
              data: { turbo: false },
              class: "inline-block px-8 py-3 font-bold text-white uppercase rounded-md bg-salmon hover:bg-salmon-medium transition-colors" %>
      </div>

    <% elsif @results.present? %>
      <%# Shown when eligibility filters had to be dropped to find any matches.
          Naming the specific filter matters: someone who asked for volunteer
          opportunities needs to know these organizations may not have any,
          rather than discovering it after contacting them. %>
      <% if @relaxations.present? %>
        <div class="mb-6 rounded-lg border border-yellow-400 bg-yellow-50 px-5 py-4" role="status">
          <p class="text-sm font-semibold text-gray-2">
            <%= t("smart_match.results.broadened.title") %>
          </p>
          <p class="mt-1 text-sm text-gray-4">
            <%= t("smart_match.results.broadened.body",
                  filters: @relaxations.map { |r| t("smart_match.results.broadened.filters.#{r}") }.to_sentence) %>
          </p>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @results.each do |match| %>
          <%= render SmartMatchCard::Component.new(
                organization: match.organization,
                match: match,
                user_type: @user_type
              ) %>
        <% end %>
      </div>

      <div class="mt-10 flex flex-col items-center gap-4">
        <%= render "shared/still_need_help_button" %>

        <hr class="w-full border-gray-6">

        <%= button_to t("smart_match.results.retake"),
              smart_match_quiz_path,
              method: :delete,
              class: "text-sm font-semibold text-gray-4 hover:text-blue-dark underline transition-colors bg-transparent border-0 cursor-pointer" %>
      </div>

    <% else %>
      <div class="p-12 text-center bg-white rounded-lg shadow-md">
        <div class="flex justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-gray-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <h2 class="mb-2 text-xl font-bold text-gray-2"><%= t("smart_match.results.empty.title") %></h2>
        <p class="mb-6 text-gray-4">
          <%= t("smart_match.results.empty.body") %>
        </p>
        <%= link_to t("smart_match.results.empty.cta"),
              smart_match_quiz_path,
              class: "inline-block px-8 py-3 font-bold text-white uppercase rounded-md bg-salmon hover:bg-salmon-medium transition-colors" %>
      </div>
    <% end %>
  </div>
</section>
