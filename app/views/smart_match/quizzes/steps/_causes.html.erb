<%
  selected_causes = @session_answers[:causes]

  # Each entry is [display_label, icon, canonical_cause_name]. The label is what
  # the user sees; the canonical name is submitted as the value so it matches a
  # real Cause#name (see Organizations::Constants::CAUSES_AND_SERVICES) and drives
  # both exact cause scoring (SmartMatch::Scorer#causes_match?) and synonym
  # expansion (UserIntent#expand_cause via matching_rules.yml cause_mappings).
  causes = [
    ["Food security", "hunger_food_security.svg", "Hunger & Food Security"],
    ["Housing & homelessness", "housing_homelessness.svg", "Housing & Homelessness"],
    ["Mental health",  "mental_health.svg", "Mental Health"],
    ["Disability advocacy", "disability_services.svg", "Disability Services"],
    ["Financial assistance", "financial_assistance.svg", "Human & Social Services"],
    ["Medical & Healthcare", "health.svg", "Health"],
    ["Employment or job training", "employment.svg", "Employment"],
    ["Justice & legal services", "justice_legal_services.svg", "Justice & Legal Services"],
    ["Support for my children or family", "children_family_services.svg", "Children & Family Services"],
    ["Help with transportation", "transportation.svg", "Transportation"],
    ["LGBTQIA+", "pride.svg", "LGBTQ+"],
    ["Veteran & military", "veteran_military.svg", "Veteran & Military"]
  ]

  more_causes = [
    ["Advocacy", "advocacy.svg", "Advocacy"],
    ["Animals", "animals.svg", "Animals"],
    ["Art & Culture", "arts_culture.svg", "Arts & Culture"],
    ["Clothing & living essentials", "clothing_living_essentials.svg", "Clothing & Living Essentials"],
    ["Community & economic development", "community_economic_development.svg", "Community & Economic Development"],
    ["Drug & alcohol treatment", "drug_alcohol_treatment.svg", "Drug & Alcohol Treatment"],
    ["Education", "education.svg", "Education"],
    ["Emergency & safety", "emergency_safety.svg", "Emergency & Safety"],
    ["Faith-based", "faith_based.svg", "Faith-Based"],
    ["Health", "health.svg", "Health"],
    ["Human & social services", "human_social_services.svg", "Human & Social Services"],
    ["Immigrant & refugee", "immigrant_refugee.svg", "Immigrant & Refugee"],
    ["Inmate & formerly incarcerated", "inmate_formerly_incarcerated.svg", "Inmate & Formerly Incarcerated"],
    ["International", "international.svg", "International"],
    ["Media & broadcasting", "media_broadcasting.svg", "Media & Broadcasting"],
    ["Philanthropy", "philanthropy.svg", "Philanthropy"],
    ["Race & ethnicity", "race_ethnicity.svg", "Race & Ethnicity"],
    ["Research & public policy",  "research_public_policy.svg", "Research & Public Policy"],
    ["Science & technology", "science_technology.svg", "Science & Technology"],
    ["Seniors", "seniors.svg", "Seniors"],
    ["Social sciences", "social_sciences.svg", "Social Sciences"]
  ]

%>

<%= form_with url: smart_match_quiz_path, method: :put, id: "quiz-form",
              data: { smart_match_quiz_target: "form" } do |f| %>

  <%# Primary causes grid %>
  <div data-card-group="causes" data-card-cols="4">
    <% causes.each do |cause_label, icon_file, cause_value| %>
      <label class="sm-card-option <%= 'selected' if selected_causes.include?(cause_value) %>"
             data-action="click->smart-match-quiz#selectCard"
             data-select-mode="multiple">
        <input type="checkbox"
               name="causes[]"
               value="<%= cause_value %>"
               class="sr-only"
               <%= "checked" if selected_causes.include?(cause_value) %>
               data-smart-match-quiz-target="causeCheckbox" />
        <span class="text-sm font-semibold leading-tight text-center"><%= cause_label %></span>
        <%= inline_svg_tag "causes_categories/#{icon_file}", class: "w-16 h-16 mt-2", aria_hidden: "true" %>
      </label>
    <% end %>
  </div>

  <%# Accordion: more causes %>
  <div class="mt-6">
    <button type="button"
            class="flex items-center gap-2 text-sm font-semibold cursor-pointer text-blue-dark hover:text-blue-medium"
            data-action="click->smart-match-quiz#toggleAccordion"
            data-smart-match-quiz-target="accordion">
      <span><%= t("smart_match.quiz.steps.causes.more_options") %></span>
      <svg class="w-4 h-4 transition-transform duration-200"
           data-smart-match-quiz-target="accordionIcon"
           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div class="sm-category-accordion" data-smart-match-quiz-target="accordionContent">
      <div data-card-group="more-causes" data-card-cols="4">
        <% more_causes.each do |cause_label, icon_file, cause_value| %>
          <label class="sm-card-option <%= 'selected' if selected_causes.include?(cause_value) %>"
                 data-action="click->smart-match-quiz#selectCard"
                 data-select-mode="multiple">
            <input type="checkbox"
                   name="causes[]"
                   value="<%= cause_value %>"
                   class="sr-only"
                   <%= "checked" if selected_causes.include?(cause_value) %>
                   data-smart-match-quiz-target="causeCheckbox" />
            <span class="text-sm font-semibold leading-tight text-center"><%= cause_label %></span>
            <%= inline_svg_tag "causes_categories/#{icon_file}", class: "w-16 h-16 mt-2", aria_hidden: "true" %>
          </label>
        <% end %>
      </div>
    </div>
  </div>

<% end %>
