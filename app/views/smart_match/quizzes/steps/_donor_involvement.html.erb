<%= form_with url: smart_match_quiz_path, method: :put, id: "quiz-form",
             data: { smart_match_quiz_target: "form" } do |f| %>
  <div data-card-group="donor_involvement" data-card-cols="4">

    <% [
      ["one_time_donation",  "smart_match/donation_hand.svg", "text-blue-dark"],
      ["learn_updates",      "smart_match/alert2.svg",        "text-blue-dark"],
      ["volunteer_events",   "smart_match/teamwork.svg",      "text-blue-dark"],
      ["deeper_involvement", "smart_match/recurrent.svg",     "text-blue-dark"]
    ].each do |value, icon, icon_class| %>
      <label class="sm-card-option <%= 'selected' if @session_answers[:donor_involvement].include?(value) %>"
             data-action="click->smart-match-quiz#selectCard"
             data-select-mode="multiple">
        <input type="checkbox" name="donor_involvement[]" value="<%= value %>"
               class="sr-only"
               <%= "checked" if @session_answers[:donor_involvement].include?(value) %>
               data-smart-match-quiz-target="causeCheckbox" />
        <span class="text-base font-bold text-center"><%= t("smart_match.quiz.steps.donor_involvement.options.#{value}") %></span>
        <%= inline_svg_tag icon, class: "w-20 h-20 mt-2 #{icon_class}", aria_hidden: "true" %>
      </label>
    <% end %>

  </div>
<% end %>
