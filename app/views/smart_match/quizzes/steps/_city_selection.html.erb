<%
  preset_cities = ["Atlantic City", "Los Angeles", "Nashville"]
  choice = @session_answers[:city_choice]
  # "Somewhere else" is active when it was explicitly chosen, or (for sessions
  # predating city_choice) when the stored location isn't one of the presets.
  elsewhere_selected = choice == "elsewhere" ||
    (choice.blank? && (
      SmartMatch::QuizNavigator::NON_LOCAL_SCOPES.include?(@session_answers[:location_scope].to_s) ||
      (@session_answers[:state].present? && preset_cities.exclude?(@session_answers[:city]))
    ))
%>
<%= form_with url: smart_match_quiz_path, method: :put, id: "quiz-form",
             data: { smart_match_quiz_target: "form" } do |f| %>
  <div data-card-group="city-selection" data-card-cols="4">

    <% [
      ["Atlantic City", "Atlantic City", "smart_match/atlantic_city.svg"],
      ["Los Angeles",   "Los Angeles",   "smart_match/california.svg"],
      ["Nashville",     "Nashville",     "smart_match/nashville.svg"]
    ].each do |label, value, icon| %>
      <% selected = choice == value || (choice.blank? && !elsewhere_selected && @session_answers[:city] == value) %>
      <label class="sm-card-option sm-card-option--blue <%= 'selected' if selected %>"
             data-action="click->smart-match-quiz#selectCard"
             data-select-mode="single">
        <%= f.radio_button :city_selection, value,
              class: "sr-only",
              checked: selected,
              data: { smart_match_quiz_target: "radio" } %>
        <%= inline_svg_tag icon, class: "w-36 h-36 mb-3", aria_hidden: "true" %>
        <span class="text-base font-bold"><%= label %></span>
      </label>
    <% end %>

    <%# "Somewhere else" — same-sized card. Choosing it routes to the follow-up
        location_detail step where the exact location/scope is captured. %>
    <label class="sm-card-option sm-card-option--blue <%= 'selected' if elsewhere_selected %>"
           data-action="click->smart-match-quiz#selectCard"
           data-select-mode="single">
      <%= f.radio_button :city_selection, "elsewhere",
            class: "sr-only",
            checked: elsewhere_selected,
            data: { smart_match_quiz_target: "radio" } %>
      <%= inline_svg_tag "smart_match/location.svg", class: "w-24 h-24 mb-3", aria_hidden: "true" %>
      <span class="text-base font-bold"><%= t("smart_match.quiz.steps.city_selection.other") %></span>
    </label>

  </div>

  <div class="sm-selection-hint mt-5 rounded-lg px-5 py-3 text-sm font-medium text-blue-dark text-center" style="background-color: #e2ecf7;">
    <%= t("smart_match.quiz.steps.city_selection.hint") %>
  </div>
<% end %>
