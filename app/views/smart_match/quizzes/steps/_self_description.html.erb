<%
  selected_self_descriptions = Array(@session_answers[:self_description])
  on_behalf_of_org = @session_answers[:support_for] == "organization"

  # [value, icon, icon_class]. icon may be nil for text-only cards. Labels come
  # from smart_match.quiz.steps.self_description.options.<value>.
  self_description_options = [
    ["student",            "smart_match/categories/user.svg",        ""],
    ["veteran",            "smart_match/categories/medal.svg",       ""],
    ["caregiver",          "smart_match/categories/care.svg",        "text-white"],
    ["lgbtqia",            "smart_match/categories/pride.svg",       ""],
    ["disability",         "smart_match/categories/disability.svg",  ""],
    ["senior",                     "smart_match/senior.svg",                        ""],
    ["children_youth",             "smart_match/youth.svg",                         ""],
    ["formerly_incarcerated",      "smart_match/law.svg",                           ""],
    ["economically_disadvantaged", "smart_match/financial_assistance.svg",           ""],
    ["currently_unhoused",         "smart_match/heart_house.svg",                   ""],
    ["mental_health",              "smart_match/mental_health.svg",                 ""],
    ["substance_use",              "smart_match/drug_alcohol_treatment.svg",        ""],
    ["health_issues",              "smart_match/health.svg",                        ""],
    (["business_nonprofit", "smart_match/categories/uphill.svg",      ""] if on_behalf_of_org),
    (["business_partner",   "smart_match/categories/partnership.svg", ""] if on_behalf_of_org)
  ].compact

  # Show options alphabetically by their displayed label, but always keep the
  # "prefer not to say / none" escape hatch pinned to the end.
  self_description_options = self_description_options.sort_by do |value, _icon, _icon_class|
    t("smart_match.quiz.steps.self_description.options.#{value}")
  end
  self_description_options << ["none", nil, ""]
%>
<%= form_with url: smart_match_quiz_path, method: :put, id: "quiz-form",
             data: { smart_match_quiz_target: "form" } do |f| %>
  <div data-card-group="self-description" data-card-cols="4">

    <% self_description_options.each do |value, icon, icon_class| %>
      <label class="sm-card-option sm-card-option--blue <%= 'selected' if selected_self_descriptions.include?(value) %>"
             data-action="click->smart-match-quiz#selectCard"
             data-select-mode="multiple">
        <input type="checkbox"
               name="self_description[]"
               value="<%= value %>"
               class="sr-only"
               <%= "checked" if selected_self_descriptions.include?(value) %> />
        <span class="text-base font-bold"><%= t("smart_match.quiz.steps.self_description.options.#{value}") %></span>
        <% if icon %>
          <%= inline_svg_tag icon, class: "w-2/3 max-w-md h-auto #{icon_class}" %>
        <% end %>
      </label>
    <% end %>

  </div>

  <div class="sm-selection-hint mt-5 rounded-lg px-5 py-3 text-sm font-medium text-blue-dark text-center" style="background-color: #e2ecf7;">
    <%= t("smart_match.quiz.steps.self_description.hint") %>
  </div>
<% end %>
