<%# Smart Match landing page %>

<%# ── Hero ─────────────────────────────────────────────────────────────── %>
<section class="sm-gradient-hero py-6 px-6 sm:py-7">
  <div class="max-w-3xl mx-auto text-center">
    <h1 class="text-3xl font-bold text-white sm:text-[40px] sm:leading-tight pb-2">
      <%= t("smart_match.landing.hero.title") %>
    </h1>
    <p class="text-sm text-white sm:text-base leading-relaxed max-w-2xl mx-auto">
      <%= t("smart_match.landing.hero.body") %>
    </p>
  </div>
</section>

<%# ── Features ─────────────────────────────────────────────────────────── %>
<section class="py-5 px-6 bg-white">
  <div class="max-w-4xl mx-auto">

    <%# Illustration %>
    <div class="flex justify-center pb-4">
      <%= image_tag "cloud-laptop.svg",
            class: "w-1/6 max-w-[130px] h-auto",
            alt: t("smart_match.landing.illustration_alt") %>
    </div>

    <%# Three feature highlights %>
    <div class="flex flex-col gap-4 sm:flex-row sm:gap-6 justify-center pb-5">

      <%# Feature 1 — Clock %>
      <div class="flex flex-col items-center text-center w-full max-w-xs sm:w-48 sm:max-w-none sm:flex-none mx-auto">
        <%= inline_svg_tag "smart_match/crono.svg", class: "w-10 h-10 mb-2 text-red-400", alt: "", "aria-hidden": "true" %>
        <h3 class="text-base font-bold text-blue-dark sm:text-md">
          <%= t("smart_match.landing.features.time") %>
        </h3>
      </div>

      <%# Feature 2 — Heart-hand %>
      <div class="flex flex-col items-center text-center w-full max-w-xs sm:w-48 sm:max-w-none sm:flex-none mx-auto">
        <%= inline_svg_tag "hand-heart.svg", class: "w-10 h-10 mb-2 text-red-400", alt: "", "aria-hidden": "true" %>
        <h3 class="text-base font-bold text-blue-dark sm:text-md">
          <%= t("smart_match.landing.features.match") %>
        </h3>
      </div>

      <%# Feature 3 — User-heart %>
      <div class="flex flex-col items-center text-center w-full max-w-xs sm:w-48 sm:max-w-none sm:flex-none mx-auto">
        <%= inline_svg_tag "user-heart.svg", class: "w-10 h-10 mb-2 text-red-400", alt: "", "aria-hidden": "true" %>
        <h3 class="text-base font-bold text-blue-dark sm:text-md">
          <%= t("smart_match.landing.features.based_on") %>
        </h3>
      </div>
    </div>

    <%# Description %>
    <p class="text-sm sm:text-base font-medium text-gray-2 text-center max-w-2xl mx-auto pb-5 leading-relaxed">
      <%= t("smart_match.landing.description") %>
    </p>

    <%# CTA %>
    <div class="text-center pb-4">
      <% if @has_results %>
        <p class="text-base font-bold text-gray-2 sm:text-lg font-[Poppins] pb-3">
          <%= t("smart_match.landing.cta.prompt_completed") %>
        </p>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <%= link_to t("smart_match.landing.cta.view_results"),
                smart_match_result_path,
                class: "inline-block px-12 py-4 text-lg font-bold tracking-wider text-blue-dark uppercase rounded-md bg-seafoam hover:bg-seafoam-light transition-colors",
                data: { test_id: "smart_match_view_results_btn" } %>

          <%= button_to t("smart_match.landing.cta.retake"),
                smart_match_quiz_path,
                method: :delete,
                class: "inline-block px-12 py-4 text-lg font-bold tracking-wider text-blue-dark uppercase rounded-md border-2 border-blue-dark bg-white hover:bg-gray-100 transition-colors cursor-pointer",
                data: { test_id: "smart_match_retake_btn" } %>
        </div>
      <% else %>
        <p class="text-base font-bold text-gray-2 sm:text-lg font-[Poppins] pb-3">
          <%= t("smart_match.landing.cta.prompt") %>
        </p>

        <%= link_to t("smart_match.landing.cta.start"),
              smart_match_quiz_path,
              class: "inline-block px-12 py-4 text-lg font-bold tracking-wider text-blue-dark uppercase rounded-md bg-seafoam hover:bg-seafoam-light transition-colors",
              data: { test_id: "smart_match_start_btn" } %>
      <% end %>
    </div>
  </div>
</section>
